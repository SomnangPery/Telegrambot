{
  "name": "sour-dataef",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --parallel --filter @sour/server --filter @sour/dashboard dev",
    "dev:server": "pnpm --filter @sour/server dev",
    "dev:dashboard": "pnpm --filter @sour/dashboard dev",
    "db:up": "docker compose up -d db",
    "db:push": "pnpm --filter @sour/db push",
    "db:seed": "pnpm --filter @sour/db seed",
    "db:import": "pnpm --filter @sour/db run import-dataef",
    "db:import-csv": "pnpm --filter @sour/db run import-csv",
    "db:setup": "pnpm db:push && pnpm db:import && pnpm db:seed",
    "probe": "pnpm --filter @sour/dataef probe",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
