# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Only needed in production (webhook mode)
TELEGRAM_WEBHOOK_SECRET=change-me
# "polling" for local dev, "webhook" in production
BOT_MODE=polling
# Public HTTPS base URL of the server (webhook mode), e.g. https://sour.up.railway.app
PUBLIC_URL=

# --- Database ---
DATABASE_URL=postgres://sour:sour@localhost:5432/sour_dataef

# --- DataEF ---
# "live" = real DataEF APIs (data.mef.gov.kh, no key needed) + Open-Meteo forecast
# "mock" = deterministic offline demo data (no network)
DATAEF_MODE=live
DATAEF_BASE_URL=https://data.mef.gov.kh
# Endpoint paths default to the real DataEF ones; override only if they change, e.g.
# DATAEF_FX_PATH=/api/v1/realtime-api/exchange-rate?currency_id=USD
# 3-day forecast source (DataEF has current conditions only)
FORECAST_URL=https://api.open-meteo.com/v1/forecast
# Mock mode only: villages that always get an urgent forecast (demo "red village")
DEMO_RED_LOCATIONS=02030101

# --- AI ---
# gemini (key from https://aistudio.google.com/apikey) or anthropic
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash

# --- Dashboard / API ---
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
DASHBOARD_URL=http://localhost:5173
SEED_OFFICER_EMAIL=officer@demo.kh
SEED_OFFICER_PASSWORD=demo1234
# Commune (or code prefix) for the demo officer's starting area; changeable in the dashboard
SEED_OFFICER_COMMUNE=0203

TZ=Asia/Phnom_Penh

# Demo: dashboard opens with a "choose a role" screen, no password. Set to false for real use.
DEMO_MODE=true
